# Klipit environment — copy to .env and fill in.

# Public URL of the deployed app (used for Stripe redirects)
APP_URL=https://klipit.onrender.com

# Claude (highlight selection)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Filled in by `npm run stripe:setup`
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# Supabase (service-role key — server only, never expose)
SUPABASE_URL=https://ucgymjcenpddqshokybj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Auto-publisher (every set of credentials switches that platform on) ---
# AUTOPOST=off to pause. Owner clips (hsw365media@ / hoodstarent365@) post themselves; subscriber opt-ins go to YouTube only.
AUTOPOST_PER_DAY=3
AUTOPOST_GAP_MIN=90
AUTOPOST_PLATFORMS=youtube,facebook,instagram,x,reddit
YT_QUEUE_KEY=pick-a-long-random-string
# YouTube (node scripts/youtube-token.js mints the refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Facebook Page + Instagram Reels (Meta Graph API; IG must be a Business/Creator account linked to the Page)
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# X (developer.x.com app with read+write, user access token)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Reddit (script app). Comma-separated subs that allow clip links
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBS=
