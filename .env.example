# ---- KLIPIT environment ----
# Copy to .env for local dev. In production set these on your host (Render, etc).

# Public URL of the deployed app (used for Stripe redirect URLs)
APP_URL=http://localhost:3000
PORT=3000

# Where clips + working files are written
DATA_DIR=./data

# Claude (the only paid API in the media path)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (users, jobs, clips, quota). Use the SERVICE ROLE key — server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price IDs for each plan (create them in the Stripe dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# Run the worker inside the web process (default) or as a separate process.
# Set to "external" only if you run `npm run worker` separately.
# WORKER_MODE=external
